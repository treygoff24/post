#!/usr/bin/env python3
"""Push wake-up for agents that live in a herdr pane.

`post watch` already tells us when mail lands. Harnesses with a Monitor tool
(Claude Code) turn that into a re-invocation; Codex and everything else only
have activity-gated hooks, so an idle session never learns it has mail until a
human says "go check". This daemon is that human.

Contract, deliberately narrow:
  - the wake carries counts and channel names, never a subject, sender or body.
    Mail content reaching a model through a door it did not open is how an
    agent ends up following instructions nobody vetted; the existing Codex hook
    holds the same line and this must not be the hole in it.
  - an agent that is `working` is never interrupted; the wake waits for it to
    settle and collapses everything that arrived meanwhile into one notice.
  - failure is silent to the pane and loud to the journal. A doorbell that
    crashes a working session is worse than a doorbell that misses a message.
"""

import argparse
import json
import os
import select
import shutil
import subprocess
import sys
import time

POLL_SETTLE_MS = 2000
NOTICE_CAP = 1500
LEGACY_CHANNEL_EPISODE = ("legacy-channel-episode", "", "")
LEGACY_WARNING = ("Post compatibility warning: unreadable channel data from an older Post "
                  "lacks channel identity. Per-message delivery is unknown; upgrade Post.")


def log(message):
    print(message, file=sys.stderr, flush=True)


def herdr_agents():
    proc = subprocess.run(["herdr", "agent", "list"], capture_output=True, text=True, check=False)
    if proc.returncode != 0:
        return []
    try:
        return json.loads(proc.stdout)["result"]["agents"]
    except (ValueError, KeyError):
        return []


def find_agent(name):
    for agent in herdr_agents():
        if agent.get("name") == name:
            return agent
    return None


def settle(target, settle_timeout_ms):
    """Wait for a working agent to settle before checking its unread mail.

    `herdr agent prompt` rejects a blocked agent outright and would queue behind
    a working one, so the wait is ours to do: an agent mid-turn gets its notice
    when the turn ends, not spliced into the middle of it.
    """
    proc = subprocess.run(
        ["herdr", "agent", "wait", target, "--until", "idle", "--until", "done",
         "--timeout", str(settle_timeout_ms)],
        capture_output=True, text=True, check=False,
    )
    return proc.returncode == 0


def deliver(target, notice):
    proc = subprocess.run(
        ["herdr", "agent", "prompt", target, notice],
        capture_output=True, text=True, check=False,
    )
    if proc.returncode != 0:
        log(f"doorbell: prompt rejected for {target}: {(proc.stderr or proc.stdout).strip()[:200]}")
        return False
    return True


def render(pending):
    """Counts and channel names only. No subject, no sender, no body."""
    parts = []
    for source in sorted(pending):
        count = pending[source]
        if not isinstance(source, str) or type(count) is not int or not 1 <= count <= 1000000000:
            continue
        label = source.split("channel:", 1)[-1] if source.startswith("channel:") else source
        if not safe_source(label):
            label = "[non-simple name]"
        kind = "#" + label if source.startswith("channel:") else label
        parts.append(f"{kind} ({count})")
    return (
        "post doorbell: new mail waiting in " + ", ".join(parts) + ". "
        "Read it with `post chat <channel>` or `post read` when you are ready. "
        "This notice is automated and carries no message content."
    )[:NOTICE_CAP]


KNOWN_REASONS = {"mail", "channel", "mention", "mixed", "all"}
DEFAULT_WAKE_ON = "mail,mention"


def safe_source(source):
    return (isinstance(source, str) and 1 <= len(source) <= 256
            and source.isascii()
            and all(c.isalnum() or c in "_:-." for c in source))


def component(value):
    return (isinstance(value, str) and 0 < len(value.encode("utf-8")) <= 255
            and value not in {".", ".."} and not any(c in "/\\" or ord(c) < 32
                                                     or 127 <= ord(c) <= 159 for c in value))


def event_metadata(event):
    """Opaque identity only; never return sender, subject, body, or preview."""
    if not isinstance(event, dict):
        raise ValueError("invalid event")
    kind, ident, reason = event.get("event"), event.get("id"), event.get("reason")
    if (kind not in {"mail", "channel_message", "unreadable"}
            or not isinstance(ident, str) or not 0 < len(ident.encode("utf-8")) <= 1024
            or reason not in {"mail", "channel", "mention"}):
        raise ValueError("invalid event metadata")
    if ((kind == "mail" and reason != "mail")
            or (kind == "unreadable" and reason == "mention")
            or (kind == "channel_message" and reason == "mail")
            or (kind != "channel_message" and not component(event.get("room")))):
        raise ValueError("invalid event reason or room")
    if kind == "channel_message" or (kind == "unreadable" and reason == "channel"
                                     and "channel" in event):
        namespace = event.get("channel")
        source = "channel:" + namespace if isinstance(namespace, str) else None
    else:
        namespace = event.get("room")
        source = "mail" if reason == "mail" else "unreadable-channel"
    if not component(namespace):
        raise ValueError("invalid event namespace")
    if source == "unreadable-channel":
        return LEGACY_CHANNEL_EPISODE, source, reason
    return (source, namespace, ident), source, reason


def parse_wake_on(spec):
    """Reason tokens -> the set watch reasons that ring. Raises on anything that
    would leave the doorbell silent, because silence is indistinguishable from
    a doorbell that is simply not being rung."""
    selected = set()
    for token in (part.strip() for part in spec.split(",")):
        if not token:
            continue
        token = "mail" if token == "direct" else token
        if token not in KNOWN_REASONS:
            raise ValueError(f"unknown --wake-on value {token!r}; known values are {sorted(KNOWN_REASONS)}")
        # Individual events have no mixed reason. Preserve the old ambiguous
        # batch opt-in in the noisy direction rather than silently selecting none.
        selected.add("all" if token == "mixed" else token)
    if not selected:
        raise ValueError("--wake-on selected nothing; refusing to start a doorbell that can never ring")
    return selected


def registered_rooms(cwd):
    """Room names `post` knows about, or None when the listing cannot be read."""
    proc = subprocess.run(["post", "rooms"], cwd=cwd, capture_output=True,
                          text=True, check=False)
    if proc.returncode != 0:
        return None
    try:
        listing = json.loads(proc.stdout)
    except ValueError:
        return None
    if not listing.get("ok"):
        return None
    return {room.get("name") for room in listing.get("rooms") or []}


def supports_own(cwd):
    """Whether the `post` on PATH knows `watch --own`.

    The flag exists so a session wearing several identities is not rung by its
    own voice. An older `post` rejects it outright, and a doorbell that dies on
    an unknown flag is worse than one that is occasionally noisy -- so this is
    detected, never assumed.
    """
    proc = subprocess.run(["post", "watch", "--help"], cwd=cwd,
                          capture_output=True, text=True, check=False)
    return "--own" in proc.stdout


def check_rooms(rooms, cwd):
    """Refuse a room `post` does not know.

    `post watch --room typo` warns once on stderr and then watches an empty
    mailbox forever, exit code and all. Inside a daemon that warning goes to the
    journal and the doorbell simply never rings -- healthy-looking and deaf,
    which is the failure this whole program exists to delete. So it is a startup
    error, not a warning. A rooms listing we cannot read is NOT treated as
    proof of absence: unreadable means unchecked, and we say so and continue.
    """
    if not rooms:
        return
    known = registered_rooms(cwd)
    if known is None:
        log("doorbell: could not read `post rooms`; starting without room validation")
        return
    unknown = sorted(set(rooms) - known)
    if unknown:
        raise ValueError(
            f"unregistered room(s) {unknown}: `post watch` would watch an empty "
            f"mailbox forever and this doorbell would never ring. Known rooms: "
            f"{sorted(known)}"
        )


def state_path(agent):
    base = os.environ.get("XDG_STATE_HOME") or os.path.expanduser("~/.local/state")
    return os.path.join(base, "post-doorbell", agent + ".json")


def load_marks(agent):
    try:
        with open(state_path(agent)) as handle:
            marks = json.load(handle)
        if not isinstance(marks, dict) or marks.get("version") != 2:
            return set()  # Legacy lexical watermarks cannot identify deliveries.
        keys = marks.get("keys")
        if not isinstance(keys, list) or any(not isinstance(k, list) or len(k) != 3
                or any(not isinstance(v, str) for v in k) for k in keys):
            return set()
        return {tuple(key) for key in keys if key[0] != "unreadable-channel"}
    except (OSError, ValueError):
        return set()


def save_marks(agent, marks):
    path = state_path(agent)
    try:
        os.makedirs(os.path.dirname(path), exist_ok=True)
        with open(path + ".tmp", "w") as handle:
            json.dump({"version": 2, "keys": sorted(marks)}, handle, sort_keys=True)
        os.replace(path + ".tmp", path)
    except OSError as exc:
        log(f"doorbell: could not persist marks: {exc}")


def snapshot_events(command, cwd, wake_on):
    """Read current unread metadata. None means unknown, never empty."""
    try:
        proc = subprocess.run(command + ["--snapshot"], cwd=cwd,
                              capture_output=True, text=True, check=False)
        if proc.returncode != 0:
            raise ValueError("snapshot failed")
        current = {}
        unreadable = False
        for line in proc.stdout.splitlines():
            if not line.strip():
                continue
            event = json.loads(line)
            key, source, reason = event_metadata(event)
            unreadable |= event["event"] == "unreadable"
            if "all" in wake_on or reason in wake_on:
                current[key] = source
        # Post deliberately warns and emits unreadable events. Other warning
        # paths can mean an incomplete scan and must not retire any keys.
        for warning in proc.stderr.splitlines():
            if warning.strip() and not (unreadable and warning.startswith((
                    "post: warning: unreadable mail ", "post: warning: unreadable channel message "))):
                raise ValueError("degraded snapshot")
        return current
    except (OSError, ValueError, TypeError):
        log("doorbell: current snapshot unavailable; wake stays pending")
        return None


def main():
    parser = argparse.ArgumentParser(description="Wake a herdr-paned agent when post mail arrives.")
    parser.add_argument("--agent", required=True, help="herdr agent name to wake")
    parser.add_argument("--room", action="append", default=[],
                        help="post room to watch; repeatable. Default: resolve from the agent's cwd")
    parser.add_argument("--wake-on", default=DEFAULT_WAKE_ON,
                        help="comma list of watch reasons that justify a wake: mail, mention, channel, or all "
                             "(direct is accepted as an alias for mail)")
    parser.add_argument("--interval-ms", type=int, default=5000, help="watch cadence")
    parser.add_argument("--quiet-ms", type=int, default=15000,
                        help="collapse everything arriving within this window into one wake")
    parser.add_argument("--ring-backlog", action="store_true",
                        help="ring for mail that was already unread at startup (default: prime past it)")
    parser.add_argument("--settle-timeout-ms", type=int, default=900000,
                        help="how long to wait for a working agent to settle before giving up on this wake")
    args = parser.parse_args()

    for executable in ("herdr", "post"):
        if shutil.which(executable) is None:
            log(f"doorbell: required executable {executable!r} not found on PATH; "
                "install it and include ~/.local/bin in the service PATH before restarting")
            return 2

    try:
        wake_on = parse_wake_on(args.wake_on)
    except ValueError as exc:
        log(f"doorbell: {exc}")
        return 2
    agent = find_agent(args.agent)
    if agent is None:
        # Most panes on a cell are never named, and `herdr agent list` omits the
        # name key entirely for those -- so this refusal is the common first
        # experience, not an edge case. A bare "not found" reads as a broken
        # daemon; say what actually fixes it and what names exist to choose from.
        known = sorted(
            a["name"] for a in herdr_agents() if a.get("name")
        )
        have = ", ".join(known) if known else "none -- no pane on this host is named"
        log(
            f"doorbell: no herdr agent named {args.agent!r}; refusing to start. "
            f"Name the pane first: herdr agent rename <pane-id> {args.agent}. "
            f"Named agents right now: {have}."
        )
        return 2
    cwd = agent.get("cwd") or os.path.expanduser("~")

    try:
        check_rooms(args.room, cwd)
    except ValueError as exc:
        log(f"doorbell: {exc}")
        return 2

    command = ["post", "watch", "--interval-ms", str(args.interval_ms)]
    for room in args.room:
        command += ["--room", room]
    # A doorbell exists to wake ONE agent about ITS mail, so the rooms it was
    # given are that agent's own identities and its own sends are not news to
    # it. Declaring them is only possible on a `post` that has the flag.
    if not args.room:
        log("doorbell: no --room given; watching the room `post` resolves from "
            f"{cwd} , with no room validation and no own-send suppression")
    if args.room:
        if supports_own(cwd):
            for room in args.room:
                command += ["--own", room]
        else:
            log("doorbell: this `post` has no `watch --own`; the agent's own "
                "sends across its rooms will ring it")
    log(f"doorbell: watching for {args.agent} (cwd {cwd}), waking on {sorted(wake_on) or ['all']}")

    marks = load_marks(args.agent)
    initial_check = False
    if not args.ring_backlog:
        initial = snapshot_events(command, cwd, wake_on)
        if initial is None:
            initial_check = True
            log("doorbell: priming unavailable; retrying, backlog may ring once")
        else:
            # Priming can acknowledge ordinary backlog, not an undelivered
            # compatibility warning. Preserve only a previously accepted episode.
            warned = LEGACY_CHANNEL_EPISODE in marks
            marks = set(initial) - {LEGACY_CHANNEL_EPISODE}
            if LEGACY_CHANNEL_EPISODE in initial:
                if warned:
                    marks.add(LEGACY_CHANNEL_EPISODE)
                initial_check = True  # check/warn, then poll until the episode clears
            save_marks(args.agent, marks)
    initial_check = initial_check or LEGACY_CHANNEL_EPISODE in marks

    # Binary pipe, read with os.read: a buffered text stream would pull a
    # whole chunk into Python's own buffer, and select() -- which watches the
    # FILE DESCRIPTOR -- cannot see what is already buffered above it. A
    # multi-room scan writes one line per room in a single write, so lines
    # 2..n would sit invisible until the next write woke select again.
    # Verified: two lines in one write, select then times out holding line 2.
    watch = subprocess.Popen(command, cwd=cwd, stdout=subprocess.PIPE)
    buffered = b""
    deadline = time.monotonic() if initial_check else None
    watch_died = False
    try:
        while True:
            # select, not a blocking read: the quiet window has to expire on its
            # own clock. A blocking readline only re-checks the deadline when the
            # NEXT message arrives, so a single message — the common case — would
            # wait for a second one that may never come.
            timeout = None if deadline is None else max(0.0, deadline - time.monotonic())
            ready, _, _ = select.select([watch.stdout], [], [], timeout)
            lines = []
            if ready:
                chunk = os.read(watch.stdout.fileno(), 65536)
                if not chunk:
                    # The watch pipe closed. A doorbell whose watcher died is a
                    # doorbell that will never ring again, and the silence is
                    # indistinguishable from "no mail" -- so say so loudly and
                    # exit non-zero, which is what makes systemd restart us.
                    watch.wait(timeout=5)
                    log(f"doorbell: `post watch` exited (rc={watch.returncode}); "
                        f"cannot ring for {args.agent} until restarted")
                    watch_died = True
                    break
                buffered += chunk
                # Keep the trailing partial line: a write can split mid-line.
                *complete, buffered = buffered.split(b"\n")
                lines = complete
            for raw in lines:
                if not raw.strip():
                    continue
                try:
                    event = json.loads(raw.decode("utf-8", "replace"))
                    key, source, reason = event_metadata(event)
                except (ValueError, TypeError):
                    continue
                fresh = key not in marks
                if fresh and ("all" in wake_on or reason in wake_on) and deadline is None:
                    # Buffered consumed triggers may request another scan, never
                    # another stale prompt. Bound their cadence without retaining
                    # an unbounded history of every event this watcher ever saw.
                    deadline = time.monotonic() + max(args.quiet_ms, POLL_SETTLE_MS) / 1000.0
            if deadline is not None and time.monotonic() >= deadline:
                refreshed = (snapshot_events(command, cwd, wake_on)
                             if settle(args.agent, args.settle_timeout_ms) else None)
                if refreshed is None:
                    deadline = time.monotonic() + max(args.quiet_ms, POLL_SETTLE_MS) / 1000.0
                    continue
                pending = {}
                for key, source in refreshed.items():
                    if key != LEGACY_CHANNEL_EPISODE and key not in marks:
                        pending[source] = pending.get(source, 0) + 1
                warn = LEGACY_CHANNEL_EPISODE in refreshed and LEGACY_CHANNEL_EPISODE not in marks
                notice = ((LEGACY_WARNING + " " if warn else "") +
                          (render(pending) if pending else ""))[:NOTICE_CAP]
                if notice and not deliver(args.agent, notice):
                    log("doorbell: wake not delivered; current notice stays pending")
                    deadline = time.monotonic() + max(args.quiet_ms, POLL_SETTLE_MS) / 1000.0
                    continue
                if pending:
                    log(f"doorbell: woke {args.agent} for {sum(pending.values())} unread")
                # Exact current identities plus a presence-only episode sentinel.
                # Neither failed snapshots nor failed warnings change this state.
                marks = set(refreshed)
                save_marks(args.agent, marks)
                deadline = (time.monotonic() + max(args.interval_ms, POLL_SETTLE_MS) / 1000.0
                            if LEGACY_CHANNEL_EPISODE in marks else None)
    except KeyboardInterrupt:
        pass
    finally:
        watch.terminate()
    return 1 if watch_died else 0


if __name__ == "__main__":
    sys.exit(main())
