    if code == 'empty':
        base = facts['contribution_base'] or facts['dispatch_base'] or 'unknown base'
        return 'lane produced no commits after its contribution base ' + str(base)
    if code == 'host-not-on-spine':
        return 'host-side commit is not on the spine'
    return 'merge refusal: ' + code

def _refusal_rows(task, facts, codes):
    return [{'task': task['id'], 'branch': facts['branch'], 'reason': _reason(code, facts)} for code in codes]

def merge_lane(task, result, owned, key, verifies):
    with MERGE_LOCK:
        return merge_lane_locked(task, result, owned, key, verifies)

def merge_lane_locked(task, result, owned, key, verifies):
    ws = WORKSPACE
    result = result if isinstance(result, dict) else {}
    recorded_head = rev(ws, result.get('head'))
    merged_head = rev(ws, str(result.get('branch', '')))
    cached = STATE.get('merges', {}).get(key)
    if cached:
        if _cached_success_is_live(ws, cached, recorded_head, merged_head, bool(task.get('host'))):
            return cached
        STATE['merges'].pop(key, None)
        _merge_intents().pop(key, None)
        save_state()
    spine_head = rev(ws, 'HEAD')
    dirty = git(ws, 'status', '--porcelain', '--untracked-files=no')[1].strip()
    facts = _collect_facts(task, result, owned, key, ws, spine_head, dirty)
    out = {'merged': [], 'refused': [], 'conflicts': [], 'verify_results': [], 'head': spine_head, 'recorded_head': facts['recorded_head'], 'merged_head': facts['merged_head']}
    codes = _effective_refusals(facts)
    intent = _merge_intents().get(key)
    recovered_merge = _recover_intent_merge(ws, intent) if not codes and _intent_matches_facts(intent, facts) else None
    if codes:
        out['refused'] = _refusal_rows(task, facts, codes)
    elif recovered_merge:
        out['merged'].append({'task': task['id'], 'branch': facts['branch'], 'merge_commit': recovered_merge, 'base': intent['base']})
    elif facts.get('already_merged'):
        base = facts['contribution_base'] or (facts['bases'][0] if facts['bases'] else spine_head)
        out['merged'].append({'task': task['id'], 'branch': facts['branch'], 'merge_commit': facts['merged_head'], 'base': base})
        if facts.get('first_parent_noop'):
            log('merge ' + key + ': ' + _ANCESTOR_NOOP_REASON)
    elif task.get('host'):
        out['refused'] = _refusal_rows(task, facts, ['host-not-on-spine'])
    else:
        intent = _save_merge_intent(key, facts, spine_head)
        rc, text = git(ws, 'merge', '--no-ff', '--no-edit', '-m', 'merge ' + task['id'] + ' (' + facts['branch'] + ')', facts['merged_head'])
        if rc:
            unmerged = _split_lines(git(ws, 'diff', '--name-only', '--diff-filter=U')[1])
            if rev(ws, 'MERGE_HEAD'):
                git(ws, 'merge', '--abort')
            _merge_intents().pop(key, None)
            save_state()
            out['conflicts'] = [{'task': task['id'], 'path': path, 'ours': spine_head, 'theirs': facts['merged_head']} for path in unmerged] or [{'task': task['id'], 'path': '(merge failed: ' + text[-300:] + ')', 'ours': spine_head, 'theirs': facts['merged_head']}]
        else:
            merge_commit = rev(ws, 'HEAD')
            intent['merge_commit'] = merge_commit
            save_state()
            out['merged'].append({'task': task['id'], 'branch': facts['branch'], 'merge_commit': merge_commit, 'base': spine_head})
    if out['merged'] and (not out['refused']):
        hook = PLAN.get('post_merge')
        triggers = PLAN.get('post_merge_triggers') or []
        if hook and any((_merge_covered(path, triggers) or os.path.basename(path) in triggers for path in facts['paths'])):
            log('post-merge hook for ' + task['id'])
            rc, text = sh_row(hook, ws, VERIFY_TIMEOUT)
            out['verify_results'].append({'run': hook, 'exit': rc, 'expect': 'exit 0', 'passed': rc == 0, 'note': text[-600:]})
        out['verify_results'] += run_verifies(ws, verifies)
        merge_commit = out['merged'][0]['merge_commit']
        if any((not row['passed'] for row in out['verify_results'])) and merge_commit != facts['merged_head']:
            current_head = rev(ws, 'HEAD')
            parent = rev(ws, merge_commit + '^1')
            if current_head == merge_commit and parent:
                git(ws, 'reset', '--hard', parent)
                log('merge ' + key + ': verify rows red; merge commit ' + merge_commit + ' reset off the spine')
                out['refused'].append({'task': task['id'], 'branch': facts['branch'], 'reason': 'verify rows red after merge; the merge commit was reset off the spine'})
                out['merged'] = []
                _merge_intents().pop(key, None)
                save_state()
            else:
                out['refused'].append({'task': task['id'], 'branch': facts['branch'], 'reason': 'verify rows red, but HEAD moved from our merge commit; refusing without reset'})
    out['head'] = rev(ws, 'HEAD')
    if not merge_bad(out, key):
        STATE.setdefault('merges', {})[key] = out
        _merge_intents().pop(key, None)
        save_state()
    log('merge ' + key + ': merged=' + str(len(out['merged'])) + ' refused=' + str(len(out['refused'])) + ' conflicts=' + str(len(out['conflicts'])) + ' red=' + str(sum((1 for row in out['verify_results'] if not row['passed']))))
    return out
"""Close-stage prompts and settlement."""
from contextlib import nullcontext
import json
import os
from pathlib import Path
import subprocess
CLOSE_VERIFIER_PERSONA = 'close-verifier'

def _runtime_plan():
    try:
        return PLAN
    except NameError:
        return globals().get('PLAN')

def _runtime_workspace():
    try:
        return WORKSPACE
    except NameError:
        return globals().get('WORKSPACE')

def _close_declared_rows(close):
    rows = list(close.get('verifies') or [])
    workflow = list(close.get('workflow_verifies') or [])
    if workflow:
        rows.append(('__workflow__', workflow))
    return rows

def _close_prompt_rows(close):
    plan = _runtime_plan() or {}
    tasks = {str(task.get('id')): task for task in _value(plan, 'tasks', ()) or () if isinstance(task, dict)}
    rows = []
    owned_groups = close.get('owned_groups') or {}
    for entry in close.get('verifies') or []:
        if len(entry) == 3:
            rows.append(entry)
            continue
        task_id, verifies = entry
        owned = list(tasks.get(str(task_id), {}).get('owned', []))
        if str(task_id) in owned_groups:
            owned = [parent + '/' + name if parent else name for parent, names in owned_groups[str(task_id)] for name in names]
        rows.append((task_id, owned, verifies))
    return rows

def _coordinator_entries(task_ids):
    state = globals().get('STATE')
    if not isinstance(state, dict):
        return {}
    coordinator = state.get('coordinator') or {}
    by_task = state.get('coordinator_tasks') or {}
    entries = {}
    for task_id in task_ids:
        for record_id in by_task.get(task_id, []) or []:
            entry = coordinator.get(str(record_id))
            if isinstance(entry, dict):
                task = entry.get('task') if isinstance(entry.get('task'), dict) else entry
                rendered = {'task': _immutable(task)}
                acknowledgement = entry.get('acknowledgement') or coordinator.get(str(record_id) + ':acknowledgement')
                if acknowledgement is not None:
                    rendered['acknowledgement'] = _immutable(acknowledgement)
                entries[str(record_id)] = rendered
    return entries

def _unacknowledged_coordinator(close):
    (globals().get('refresh_state') or (lambda: None))()
    pending = []
    for record_id, entry in _coordinator_entries(close.get('task_ids') or []).items():
        task = entry.get('task') if isinstance(entry.get('task'), dict) else entry
        if task.get('blocking') is False and (not entry.get('acknowledgement')):
            pending.append(record_id)
    return pending

def _close_result_failed(value, close):
    pending = _unacknowledged_coordinator(close)
    if pending:
        reject_cached('close:' + str(close.get('wave', '?')), 'unacknowledged coordinator work: ' + ', '.join(pending))
        return True
    declared = _close_declared_rows(close)
    return close_failed(value, declared, close.get('task_ids') or [], close.get('build_ids') or [], False, globals().get('MAIN_BRANCH', 'main'))

def _value(source, key, default=None):
    if isinstance(source, dict):
        return source.get(key, default)
    return getattr(source, key, default)

def _close_plan(item=None):
    plan = _runtime_plan()
    if plan is not None:
        return plan
    if item and isinstance(item, dict) and (item.get('plan') is not None):
        return item['plan']
    return None

def _workspace_for(plan, wave):
    repo = _value(plan, 'repo')
    if repo is None:
        workspace = _runtime_workspace()
        repo = Path(workspace).parent.parent if workspace else Path.cwd()
    name = _value(plan, 'name', 'plan')
    return Path(repo) / '.worktrees' / f'plan-{name}-close-{wave}'

def _merge_lock_context():
    lock = globals().get('MERGE_LOCK')
    return lock if lock is not None else nullcontext()

def _git_call(cwd, *argv):
    runner = globals().get('git')
    if callable(runner):
        return runner(cwd, *argv)
    proc = subprocess.run(['git', '-C', str(cwd), *argv], capture_output=True, text=True, check=False)
    return (proc.returncode, (proc.stdout or '') + (proc.stderr or ''))

def _save_runtime_state():
    saver = globals().get('save_state')
    if callable(saver):
        saver()

def _snapshot_head(item, wave):
    key = 'close:' + str(wave)
    reader = globals().get('recorded_head')
    if callable(reader):
        pinned = reader(key)
        if pinned:
            return pinned
    state = globals().get('STATE')
    if not isinstance(state, dict):
        return None
    heads = state.setdefault('heads', {})
    if heads.get(key) is None:
        workspace = _runtime_workspace()
        ref_reader = globals().get('rev')
        resolved = ref_reader(workspace, 'HEAD') if callable(ref_reader) else None
        if resolved is None:
            return None
        heads[key] = resolved
        _save_runtime_state()
    return heads.get(key)

def _immutable(value):
    return json.loads(json.dumps(value, sort_keys=True, default=str))

def _integration_receipts(task_ids):
    state = globals().get('STATE')
    merge_state = state.get('merges', {}) if isinstance(state, dict) else {}
    receipts = {}
    for task_id in task_ids:
        keys = [key for key in merge_state if key == task_id + ':execute' or key.startswith(task_id + ':fix:')]
        receipts[task_id] = [dict(row, stage=key) for key in sorted(keys) for row in (merge_state[key].get('merged', []) if isinstance(merge_state[key], dict) else [])]
    return _immutable(receipts)

def _task_baselines(task_ids, wave=None):
    state = globals().get('STATE')
    task_bases = state.get('task_bases', {}) if isinstance(state, dict) else {}
    bases = {}
    wanted = set(task_ids)
    for key, value in task_bases.items():
        if not isinstance(key, str):
            continue
        task_id = key.split(':', 1)[0]
        if task_id in wanted:
            bases[key] = value
    return _immutable(bases)

def _prepare_close_worktree(workspace, worktree, head):
    if worktree.exists():
        rc, top = _git_call(worktree, 'rev-parse', '--show-toplevel')
        if rc or os.path.realpath(top.strip()) != os.path.realpath(str(worktree)):
            raise RuntimeError('refusing to use non-worktree close path ' + str(worktree))
        rc, output = _git_call(worktree, 'checkout', '--detach', '--force', str(head))
        if rc:
            raise RuntimeError('close worktree checkout failed: ' + output[-400:])
        rc, output = _git_call(worktree, 'clean', '-fdq')
        if rc:
            raise RuntimeError('close worktree clean failed: ' + output[-400:])
    else:
        if Path(workspace).exists():
            worktree.parent.mkdir(parents=True, exist_ok=True)
        rc, output = _git_call(workspace, 'worktree', 'add', '--detach', '--force', str(worktree), str(head))
        if rc:
            raise RuntimeError('close worktree add failed: ' + output[-400:])
    rc, checked_out = _git_call(worktree, 'rev-parse', 'HEAD')
    if rc or not checked_out.strip() or checked_out.strip() != str(head):
        raise RuntimeError('close worktree is not pinned at ' + str(head))

def _snapshot_close(item, plan, close):
    state = globals().get('STATE')
    if not isinstance(state, dict):
        state = {}
        globals()['STATE'] = state
    snapshots = state.setdefault('close_snapshots', {})
    close_id = str(item.get('id', 'close:' + str(item.get('wave'))))
    wave = item.get('wave')
    workspace = _runtime_workspace() or _value(plan, 'repo')
    if not workspace:
        raise RuntimeError('close workspace is unavailable')
    head = _snapshot_head(item, wave)
    existing = snapshots.get(close_id)
    observed = _current_workspace_head()
    if not head or not observed:
        raise RuntimeError('cannot read integration HEAD for close snapshot')
    if isinstance(existing, dict) and existing.get('spine_head') == head and (observed == head):
        saved_worktree = Path(existing.get('worktree') or _workspace_for(plan, wave))
        _prepare_close_worktree(workspace, saved_worktree, head)
        return existing
    if observed != head:
        state.setdefault('heads', {}).pop(close_id, None)
        state.setdefault('heads', {}).pop('close:' + str(wave), None)
        snapshots.pop(close_id, None)
        _save_runtime_state()
        head = _snapshot_head(item, wave)
        if not head or head != observed:
            raise RuntimeError('integration HEAD moved while creating close snapshot')
    worktree = _workspace_for(plan, wave)
    _prepare_close_worktree(workspace, worktree, head)
    snapshot = {'spine_head': head, 'worktree': str(worktree), 'receipts': _integration_receipts(close.get('task_ids') or []), 'task_baselines': _task_baselines(close.get('task_ids') or [], wave)}
    snapshots[close_id] = _immutable(snapshot)
    _save_runtime_state()
    return snapshots[close_id]

def _final_close_verifies(plan):
    audit = f"bin/delegate-audit --since docs/acceptance/build-start.txt --plan {_value(plan, 'path')} --receipts docs/receipts/audit"
    return [('tests/acceptance.sh', 'exit 0'), (audit, 'exit 0')]

def _close_prompt_parts(plan, wave, final_build, close_workspace=None):
    close_workspace = close_workspace or _workspace_for(plan, wave)
    prefix = f'Run as {CLOSE_VERIFIER_PERSONA} in {close_workspace}, a pinned detached close worktree created from the integration worktree on the spine. Verify and close wave {wave}. Re-run every task verify row '
    body = f"; before any close-side write, confirm the pinned spine HEAD equals integration.spine_head; each task's receipts are the explicit merge commits and bases listed for it under integration.receipts; confirm each receipt is a commit whose diff touches only the owned files listed for that task above plus the fix-task owned files attached as fix_owned for that task. Measure each receipt only as `git diff <base> <merge_commit>` using its attached immutable base; union those paths for the task. Do not attribute paths with a live wave-base..HEAD range. Refuse an empty build diff, and close each bead found by metadata plan={_value(plan, 'name')} and task id with commit and verify evidence. Report diff_nonempty and bead_closed as {{task id: bool}} maps covering every real task in the task verify rows. The task_baselines in RESULTS are immutable persisted values: never re-observe HEAD at integrate start. Report each row's four-key declared_row_id; missing rows belong in refused_rows, never in a vacuous complete report. "
    if final_build:
        audit_run = _final_close_verifies(plan)[1][0]
        body += f'Create acceptance_output=$(mktemp -p /tmp) and audit_output=$(mktemp -p /tmp), both outside the worktree. Run tests/acceptance.sh > "$acceptance_output". After it exits, cp "$acceptance_output" docs/acceptance/demo-output.md. Then run {audit_run} > "$audit_output". After it exits, cp "$audit_output" docs/acceptance/audit-report.md. List and review the files to stage: docs/acceptance/demo-output.md, docs/acceptance/audit-report.md, and every path printed by git ls-files --others --exclude-standard docs/receipts/audit. Then run git add -- with exactly those reviewed paths, never a directory, and commit them in the detached close worktree, reporting that commit as acceptance_commit. Do not merge or fast-forward any branch. These capture runs are the workflow-level verify-row executions: run each exactly once, do not execute the rows separately, and report their declared run and expect values without alteration. '
    if final_build:
        final = f"Report the current head of the branch checked out at {_value(plan, 'repo')} as main_head, its branch name as main_branch, and the pinned spine head as spine_head; the close coordinator validates and publishes acceptance_commit after this result is complete."
    else:
        final = f"Do not merge into {_value(plan, 'repo')}: later waves are already pipelined onto the spine and only the final build wave publishes. Report the current head of the branch checked out at {_value(plan, 'repo')} as main_head, its branch name as main_branch, and the spine head as spine_head."
    final += _VERIFY_ADDENDUM
    return (prefix, body, final)

def _close_prompt(plan, wave, tasks, final_build, close_workspace=None):
    verifies = [(task.id, [name for name in task.owned_files if not Path(name).is_absolute()], [(row.run, row.expect) for row in task.verify]) for task in tasks]
    prefix, body, final = _close_prompt_parts(plan, wave, final_build, close_workspace)
    prompt = prefix + repr(verifies)
    if final_build:
        prompt += '\n\nWorkflow-level rows (not tasks; no receipt, bead, diff_nonempty, or bead_closed entry): ' + repr(_final_close_verifies(plan))
    return prompt + body + final

def _with_results(instruction, results):
    writer = globals().get('with_results')
    if callable(writer):
        return writer(instruction, results)
    return 'RESULTS\n' + json.dumps(results, sort_keys=True, default=str) + '\n\n' + instruction

def close_entries(item):
    wave = PLAN['waves'][str(item['wave'])]
    close = wave['close']
    plan = _close_plan(item)
    with _merge_lock_context():
        snapshot = _snapshot_close(item, plan, close)
    close_workspace = snapshot.get('worktree') if isinstance(snapshot, dict) else None
    if close_workspace and _value(plan, 'path') is not None:
        prefix, body, final = _close_prompt_parts(plan, item['wave'], close.get('final_build', False), close_workspace)
        prompt = prefix + repr(_close_prompt_rows(close))
        if close['workflow_verifies']:
            prompt += '\n\nWorkflow-level rows (not tasks; no receipt, bead, diff_nonempty, or bead_closed entry): ' + repr(close['workflow_verifies'])
        prompt += body + final
    else:
        prefix = close['prefix']
        if close_workspace:
            integration = str(_runtime_workspace() or '')
            if integration and integration in prefix:
                prefix = prefix.replace('Run in ' + integration, f'Run as {CLOSE_VERIFIER_PERSONA} in {close_workspace}, a pinned detached close worktree', 1)
        prompt = prefix + repr(_close_prompt_rows(close))
        if close['workflow_verifies']:
            prompt += '\n\nWorkflow-level rows (not tasks; no receipt, bead, diff_nonempty, or bead_closed entry): ' + repr(close['workflow_verifies'])
        prompt += close['body'] + close['final']
    verifier = dict(wave.get('verifier') or {})
    verifier['persona'] = CLOSE_VERIFIER_PERSONA
    verifier['schema'] = 'CLOSE_RESULT'
    merges = {task_id: globals().get('ITEMS', {}).get(task_id, {}).get('integration') for task_id in wave['task_ids'] if task_id in globals().get('ITEMS', {})}
    merges = _immutable(merges)
    receipts = snapshot.get('receipts', {}) if isinstance(snapshot, dict) else _integration_receipts(wave['task_ids'])
    fix_owned = {task_id: globals().get('ITEMS', {}).get(task_id, {}).get('fix_owned', []) for task_id in wave['task_ids'] if task_id in globals().get('ITEMS', {})}
    fix_owned = _immutable(fix_owned)
    state = globals().get('STATE', {})
    wave_base = state.get('bases', {}).get(str(item['wave'])) if isinstance(state, dict) else None
    results = {'wave_' + str(item['wave']) + '_base': wave_base, 'integration': {'spine_head': snapshot.get('spine_head') if isinstance(snapshot, dict) else _snapshot_head(item, item['wave']), 'merges': merges, 'receipts': receipts, 'task_baselines': snapshot.get('task_baselines', {}) if isinstance(snapshot, dict) else _task_baselines(wave['task_ids'], item['wave']), 'accepted_residue': {task_id: [finding.get('id') for finding in findings] for task_id, findings in _accepted_residue(close) if findings}}, 'fix_owned': fix_owned, 'coordinator': _coordinator_entries(wave['task_ids'])}
    return [{'spec': verifier, 'prompt': _with_results(prompt, results), 'slot': 0, 'label': 'close:' + str(item['wave']), 'retry_label': 'close-retry:' + str(item['wave']), 'phase': globals().get('stage_phase')(item, 'close') if callable(globals().get('stage_phase')) else 'wave-' + str(item['wave']) + ':close', 'bad': lambda value: _close_result_failed(value, close)}]

def _invalidate_close_snapshot(item):
    state = globals().get('STATE')
    if not isinstance(state, dict):
        return
    close_id = str(item.get('id', 'close:' + str(item.get('wave'))))
    heads = state.setdefault('heads', {})
    heads.pop(close_id, None)
    state.setdefault('close_snapshots', {}).pop(close_id, None)
    _save_runtime_state()

def _failure_gate(stage, wave, value):
    gate = globals().get('failure_gate')
    if callable(gate):
        return gate(stage, wave, value)
    raise RuntimeError(stage + ' close gate: ' + repr(value))

def _mark_close_done(item):
    marker = globals().get('mark_done')
    if callable(marker):
        marker(item)
    else:
        item['stage'] = 'done'

def _close_snapshot_for(item):
    state = globals().get('STATE')
    if not isinstance(state, dict):
        return {}
    close_id = str(item.get('id', 'close:' + str(item.get('wave'))))
    return state.get('close_snapshots', {}).get(close_id) or {}

def _current_workspace_head():
    workspace = globals().get('WORKSPACE')
    reader = globals().get('rev')
    return reader(workspace, 'HEAD') if callable(reader) and workspace else None

def _accepted_residue(close):
    items = globals().get('ITEMS', {})
    adjudications = globals().get('adjudication', {})
    reviews = globals().get('review', {})
    collected = []
    for task_id in close.get('task_ids') or []:
        item = items.get(task_id, {}) if isinstance(items, dict) else {}
        adjudication_value = item.get('adjudication') or (adjudications.get(task_id) if isinstance(adjudications, dict) else None) or {}
        ids = adjudication_value.get('accepted_residue') or []
        finding_by_id = {}
        for panel in reviews.get(task_id, []) if isinstance(reviews, dict) else []:
            entries = panel if isinstance(panel, list) else [panel]
            for finding in entries:
                if isinstance(finding, dict) and finding.get('id'):
                    finding_by_id[str(finding['id'])] = finding
        collected.append((task_id, [finding_by_id.get(str(finding_id), {'id': str(finding_id)}) for finding_id in ids]))
    return collected

def _standalone_residue_bead(repo, plan_name, task_id, finding):
    if not (Path(repo) / '.beads').is_dir():
        return None
    finding_id = str(finding.get('id'))
    metadata = {'plan': str(plan_name), 'task': str(task_id), 'finding_id': finding_id, 'discovered_from': 'accepted-residue'}
    listing = subprocess.run(['bd', '-C', str(repo), 'list', '--json', '-n', '0', '--all'], capture_output=True, text=True, check=False)
    if listing.returncode:
        raise RuntimeError('residue bead lookup failed: ' + (listing.stderr or listing.stdout)[-300:])
    try:
        rows = json.loads(listing.stdout)
    except json.JSONDecodeError as exc:
        raise RuntimeError('residue bead lookup returned invalid JSON: ' + str(exc)) from None
    if isinstance(rows, dict):
        rows = [rows]
    matching = [row for row in rows if isinstance(row, dict) and (row.get('metadata') or {}).get('plan') == str(plan_name) and ((row.get('metadata') or {}).get('task') == str(task_id)) and ((row.get('metadata') or {}).get('finding_id') == finding_id)]
    if matching:
        bead_id = next((row.get('id') for row in matching if row.get('status') != 'closed'), matching[0].get('id'))
        if not bead_id:
            raise RuntimeError('residue bead lookup returned no id')
        updated = subprocess.run(['bd', '-C', str(repo), 'update', str(bead_id), '--title', f'accepted residue {finding_id} ({task_id})', '--metadata', json.dumps(metadata)], capture_output=True, text=True, check=False)
        if updated.returncode:
            raise RuntimeError('residue bead update failed: ' + (updated.stderr or updated.stdout)[-300:])
        return str(bead_id)
    parent = next((row.get('id') for row in rows if isinstance(row, dict) and (row.get('metadata') or {}).get('plan') == str(plan_name) and ((row.get('metadata') or {}).get('task') == str(task_id))), None)
    command = ['bd', '-C', str(repo), 'create', f'accepted residue {finding_id} ({task_id})', '-d', 'Accepted residue finding ' + finding_id, '--type', 'task', '--priority', '2', '--metadata', json.dumps(metadata), '--silent']
    if parent:
        command += ['--parent', str(parent)]
    created = subprocess.run(command, capture_output=True, text=True, check=False)
    if created.returncode:
        raise RuntimeError('residue bead create failed: ' + (created.stderr or created.stdout)[-300:])
    bead_id = created.stdout.strip().splitlines()[-1] if created.stdout.strip() else ''
    if not bead_id:
        raise RuntimeError('residue bead create returned no id')
    return bead_id

def _upsert_residue_receipts(plan, close):
    adapter = globals().get('beads_adapter')
    bulk = getattr(adapter, 'upsert_residue_beads', None) if adapter is not None else None
    single = getattr(adapter, 'upsert_residue_bead', None) if adapter is not None else None
    repo = _value(plan, 'repo')
    if repo is None:
        workspace = globals().get('WORKSPACE')
        repo = Path(workspace).parent.parent if workspace else None
    if repo is None:
        return {}
    name = _value(plan, 'name', 'plan')
    result = {}
    for task_id, findings in _accepted_residue(close):
        if not findings:
            continue
        if callable(bulk):
            mapping = bulk(repo, name, task_id, findings)
        elif callable(single):
            mapping = {str(finding.get('id')): single(repo, name, task_id, finding) for finding in findings}
        else:
            mapping = {str(finding.get('id')): _standalone_residue_bead(repo, name, task_id, finding) for finding in findings}
        if isinstance(mapping, dict):
            result[str(task_id)] = {str(key): str(value) for key, value in mapping.items() if value is not None}
    return result

def _attach_acceptance_commit(plan, pinned_head, acceptance_commit, close_worktree):
    workspace = globals().get('WORKSPACE')
    if not workspace:
        return (None, 'integration workspace is unavailable')
    rc, current = _git_call(workspace, 'rev-parse', 'HEAD')
    if rc or not current.strip() or current.strip() != str(pinned_head):
        return (None, 'integration HEAD moved before acceptance attachment')
    rc, resolved = _git_call(workspace, 'rev-parse', '--verify', str(acceptance_commit) + '^{commit}')
    resolved = resolved.strip()
    if rc or not resolved:
        return (None, 'cannot resolve acceptance_commit')
    if not close_worktree:
        return (None, 'saved close worktree is unavailable')
    rc, saved_head = _git_call(close_worktree, 'rev-parse', 'HEAD')
    saved_head = saved_head.strip()
    if rc or not saved_head:
        return (None, 'cannot read saved close worktree HEAD')
    if saved_head != resolved:
        return (None, 'acceptance_commit is not the saved close worktree HEAD')
    if _git_call(workspace, 'merge-base', '--is-ancestor', str(pinned_head), resolved)[0]:
        return (None, 'acceptance_commit is not based on the pinned spine')
    rc, output = _git_call(workspace, 'merge', '--ff-only', resolved)
    if rc:
        return (None, 'acceptance attachment failed: ' + output[-300:])
    rc, attached = _git_call(workspace, 'rev-parse', 'HEAD')
    if rc or attached.strip() != resolved:
        return (None, 'acceptance attachment did not land at ' + resolved)
    return (resolved, None)

def _fast_forward_main(plan, value, acceptance_commit):
    repo = _value(plan, 'repo')
    if repo is None:
        workspace = globals().get('WORKSPACE')
        repo = Path(workspace).parent.parent if workspace else None
    if repo is None:
        return 'main repository is unavailable'
    expected_branch = str(value.get('main_branch', ''))
    rc, branch = _git_call(repo, 'branch', '--show-current')
    branch = branch.strip()
    if rc:
        return 'cannot read main branch: ' + branch[-300:]
    if not branch:
        return 'main checkout is detached'
    if branch and expected_branch and (branch != expected_branch):
        return 'main branch moved from ' + expected_branch + ' to ' + branch
    rc, output = _git_call(repo, 'merge', '--ff-only', str(acceptance_commit))
    if rc:
        return 'final fast-forward failed: ' + output[-300:]
    rc, head = _git_call(repo, 'rev-parse', 'HEAD')
    observed = head.strip()
    if rc or not observed or observed != str(acceptance_commit):
        return 'final fast-forward landed at ' + observed + ', expected ' + str(acceptance_commit)
    return None

def settle_close(item, value):
