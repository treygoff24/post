def _closed(plan, run=None):
    if not plan.repo.is_dir() or not (plan.repo / '.beads').is_dir():
        return set()
    command = ['bd', '-C', str(plan.repo), 'list', '--metadata-field', f'plan={plan.name}', '--json', '-n', '0', '--all']
    runner = run or subprocess.run
    proc = runner(command, capture_output=True, text=True, check=False)
    rendered = ' '.join(command)
    if proc.returncode:
        detail = (proc.stderr or proc.stdout).strip()
        raise PlanError('beads-query', f'`{rendered}` failed: {detail}')
    try:
        rows = json.loads(proc.stdout)
    except json.JSONDecodeError as exc:
        raise PlanError('beads-query', f'`{rendered}` returned invalid JSON: {exc}') from None
    if isinstance(rows, dict):
        rows = [rows]
    if not isinstance(rows, list) or not all((isinstance(row, dict) for row in rows)):
        raise PlanError('beads-query', f'`{rendered}` returned JSON that is not a list of beads')
    closed = set()
    for row in rows:
        metadata = row.get('metadata', {})
        if not isinstance(metadata, dict):
            raise PlanError('beads-query', f'`{rendered}` returned a bead with invalid metadata')
        task_id = metadata.get('task')
        if row.get('status') == 'closed' and task_id:
            closed.add(str(task_id))
    return closed

def _main_branch(plan):
    if not plan.repo.is_dir():
        return 'main'
    proc = subprocess.run(['git', '-C', str(plan.repo), 'symbolic-ref', '--short', 'refs/remotes/origin/HEAD'], capture_output=True, text=True, check=False)
    branch = proc.stdout.strip().removeprefix('origin/') if proc.returncode == 0 else ''
    if branch and branch != f'plan/{plan.name}':
        return branch
    for branch in ('main', 'master'):
        proc = subprocess.run(['git', '-C', str(plan.repo), 'rev-parse', '--verify', '--quiet', f'refs/heads/{branch}'], capture_output=True, text=True, check=False)
        if proc.returncode == 0:
            return branch
    return 'main'

