def _active_record(task_id, regime='standard', now=None):
    now = wall_time() if now is None else now
    clocks = STATE.setdefault('active_clocks', {})
    return clocks.setdefault(task_id, {'regime': regime, 'accumulated': 0.0, 'resumed_at': now, 'parked_at': None})

def active_clock_resume(task_id, regime='standard', now=None):
    now = wall_time() if now is None else now
    record = _active_record(task_id, regime, now)
    record['regime'] = regime or record.get('regime', 'standard')
    if record.get('resumed_at') is None:
        record['resumed_at'] = now
    record['parked_at'] = None
    return record

def active_clock_pause(task_id, now=None):
    now = wall_time() if now is None else now
    record = _active_record(task_id, now=now)
    resumed = record.get('resumed_at')
    if resumed is not None:
        record['accumulated'] = float(record.get('accumulated', 0.0)) + max(0.0, now - resumed)
    record['resumed_at'] = None
    record['parked_at'] = now
    return record

def active_seconds(task_id, now=None):
    now = wall_time() if now is None else now
    record = _active_record(task_id, now=now)
    total = float(record.get('accumulated', 0.0))
    if record.get('resumed_at') is not None:
        total += max(0.0, now - record['resumed_at'])
    return total

