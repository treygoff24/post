    elif run_limit and run_total >= run_limit:
        breached = {'kind': 'run-claim-ceiling', 'limit': run_limit, 'observed': run_total}
    elif active > active_limit:
        breached = {'kind': 'active-clock', 'limit': active_limit, 'observed': active}
    if breached:
        failure_gate('guardrail', item.get('wave', '?'), breached, task_id)
    claims[label] = {'id': label, 'task_id': task_id, 'regime': regime, 'phase': label.split(':', 1)[0]}
