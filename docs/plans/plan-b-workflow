            adopted_ids = {*[row['finding_id'] for row in value['verdicts']], *[row['finding_id'] for row in value['unrun']]}
        else:
            adopted_ids = set(known_ids)
    else:
        if isinstance(adopted, dict):
            adopted = [adopted]
        if all((isinstance(item, dict) for item in adopted)):
            adopted_ids = {item['id'] for item in adopted}
            for item in adopted:
                validate_finding(item)
        else:
            adopted_ids = set(adopted)
    if known_ids is not None:
        for finding_id in adopted_ids:
            _require_reference(finding_id, known_ids, 'adopted finding')
    seen = set()
    for verdict in value['verdicts']:
        finding_id = verdict['finding_id']
        _require_reference(finding_id, known_ids, 'verdict')
        if finding_id not in adopted_ids:
            raise ContractError('unexpected-finding-id', f'verdict names non-adopted finding `{finding_id}`')
        if finding_id in seen:
            raise ContractError('duplicate-fix-verdict', f'finding `{finding_id}` has more than one verdict')
        seen.add(finding_id)
    for entry in value['unrun']:
        finding_id = entry['finding_id']
        _require_reference(finding_id, known_ids, 'unrun')
        if finding_id not in adopted_ids:
            raise ContractError('unexpected-finding-id', f'unrun names non-adopted finding `{finding_id}`')
        if finding_id in seen:
            raise ContractError('duplicate-fix-verdict', f'finding `{finding_id}` has both a verdict and unrun entry')
        seen.add(finding_id)
    if seen != adopted_ids:
        missing = sorted(adopted_ids - seen)
        raise ContractError('missing-fix-verdict', f'adopted finding(s) have no verdict or unrun entry: {missing}')
    allowed_regressions = fix_finding_ids if fix_finding_ids is not None else diff_finding_ids
    if allowed_regressions is not None:
        allowed_regressions = set(allowed_regressions)
    regression_ids = set()
    for finding in value['regressions']:
        validate_finding(finding)
        finding_id = finding['id']
        if finding_id in regression_ids:
            raise ContractError('duplicate-regression', f'regression `{finding_id}` appears twice')
        regression_ids.add(finding_id)
        if allowed_regressions is not None and finding_id not in allowed_regressions:
            raise ContractError('regression-outside-fix-diff', f'regression `{finding_id}` is outside the fix diff')
    return value

def normalize_run(run):
    if not isinstance(run, str):
        raise ContractError('bad-run', 'verify run must be a string')
    normalized = re.sub('\\s+', ' ', run.strip())
    if normalized.endswith(';'):
        normalized = normalized[:-1].rstrip()
    return normalized

def canonical_test_path(path):
    if not isinstance(path, str):
        raise ContractError('bad-path', 'path must be a string')
    parts = path.split('/')
    if len(parts) >= 2 and parts[-2] == '__tests__' and parts[-1].endswith('.test.ts'):
        return '/'.join([*parts[:-2], parts[-1]])
    return path

def _as_row_id(value, *, default_task='', default_index=0, default_run='', default_expect=''):
    if isinstance(value, dict):
        nested = value.get('declared_row_id', value.get('row_id'))
        if nested is not None:
            return _as_row_id(nested)
        value = (value.get('task_id', default_task), value.get('index', default_index), value.get('normalized_run', value.get('run', default_run)), value.get('expect', default_expect))
    try:
        if isinstance(value, DECLARED_ROW_ID):
            parts = (value.task_id, value.index, value.normalized_run, value.expect)
        elif isinstance(value, (list, tuple)) and len(value) == 4:
            parts = value
        elif isinstance(value, (list, tuple)) and len(value) == 2:
            parts = (default_task, default_index, value[0], value[1])
        elif value is None:
            parts = (default_task, default_index, default_run, default_expect)
        else:
            raise ContractError('bad-declared-row-id', 'declared row id must contain task, index, run, and expect')
        return DECLARED_ROW_ID(str(parts[0]), int(parts[1]), normalize_run(parts[2]), str(parts[3]))
    except ContractError:
        raise
    except (TypeError, ValueError) as exc:
        raise ContractError('bad-declared-row-id', 'declared row id has invalid field types') from exc

def _iter_declared_rows(declared):
    if declared is None:
        return []
    rows = []
    for position, entry in enumerate(declared):
        if isinstance(entry, dict) and 'verify' in entry:
            task_id = entry.get('task_id', entry.get('id', ''))
            for index, row in enumerate(entry['verify']):
                rows.append(_as_row_id(row, default_task=task_id, default_index=index))
            continue
        if isinstance(entry, tuple) and len(entry) == 3 and isinstance(entry[2], (list, tuple)):
            task_id, _owned, verify = entry
            for index, row in enumerate(verify):
                rows.append(_as_row_id(row, default_task=task_id, default_index=index))
            continue
        if isinstance(entry, tuple) and len(entry) == 2 and isinstance(entry[1], (list, tuple)):
            task_id, verify = entry
            for index, row in enumerate(verify):
                rows.append(_as_row_id(row, default_task=task_id, default_index=index))
            continue
        if isinstance(entry, (list, tuple)) and len(entry) == 2:
            rows.append(_as_row_id(entry, default_task='', default_index=position))
            continue
        rows.append(_as_row_id(entry, default_index=position))
    return rows

def _reported_row_id(row, position):
    nested = row.get('declared_row_id', row.get('row_id'))
    if nested is not None:
        return _as_row_id(nested)
    run = row.get('normalized_run', row.get('run', ''))
    expect = str(row.get('expect', ''))
    normalized = normalize_run(run)
    if 'task_id' in row or 'index' in row:
        return DECLARED_ROW_ID(str(row.get('task_id', '')), int(row.get('index', position)), normalized, expect)
    return None

def _row_passed(row):
    if 'passed' in row:
        return row['passed'] is True
    return isinstance(row.get('exit'), int) and (not isinstance(row.get('exit'), bool)) and (row['exit'] == 0)

def row_coverage(reported, declared):
    if isinstance(reported, dict):
        reported = reported.get('verify_results', [])
    if not isinstance(reported, (list, tuple)):
        reported = []
    declared_rows = _iter_declared_rows(declared)
    consumed = set()
    matched = []
    missing = []
    failing = []
    extra = []
    by_exact = {row: index for index, row in enumerate(declared_rows)}
    for position, row in enumerate(reported):
        if not isinstance(row, dict):
            extra.append(_as_row_id(None, default_index=position))
            continue
        explicit = _reported_row_id(row, position)
        normalized = normalize_run(row.get('normalized_run', row.get('run', '')))
        task_id = str(row.get('task_id', ''))
        candidates = []
        if explicit is not None and explicit in by_exact and (by_exact[explicit] not in consumed):
            candidates = [by_exact[explicit]]
        else:
            for index, declared_row in enumerate(declared_rows):
                if index in consumed or declared_row.normalized_run != normalized:
                    continue
                if task_id and declared_row.task_id != task_id:
                    continue
                candidates.append(index)
        if not candidates:
            extra.append(explicit or DECLARED_ROW_ID(task_id, int(row.get('index', position)), normalized, str(row.get('expect', ''))))
            continue
        target = failing if not _row_passed(row) else matched
        for index in candidates:
            consumed.add(index)
            target.append(declared_rows[index])
    for index, declared_row in enumerate(declared_rows):
        if index not in consumed:
            missing.append(declared_row)
    return {'matched': matched, 'missing': missing, 'failing': failing, 'extra': extra}

def validate_close_result(value, declared=None, task_ids=None, build_ids=None, final=False, main_branch=None):
    _validate_transport(value, CLOSE_RESULT)
    for index, result in enumerate(value['verify_results']):
        if not result['note'].strip():
            raise ContractError('empty-note', 'close verify result notes must not be empty', f'value.verify_results[{index}].note')
    declared_rows = _iter_declared_rows(declared)
    computed = row_coverage(value['verify_results'], declared_rows) if declared is not None else None
    supplied = value['row_coverage']
    coverage_ids = {}
    for key, rows in supplied.items():
        ids = [_as_row_id(row) for row in rows]
        if len(ids) != len(set(ids)):
            raise ContractError('duplicate-row-id', f'row_coverage.{key} contains a duplicate identity')
        coverage_ids[key] = set(ids)
    supplied_sets = coverage_ids
    if computed is not None:
        computed_sets = {key: set(computed[key]) for key in computed}
        if supplied_sets != computed_sets:
            raise ContractError('row-coverage-mismatch', 'row_coverage does not describe verify_results')
    expected_tasks = set(value['bead_closed']) if task_ids is None else set(task_ids)
    expected_builds = set(value['diff_nonempty']) if build_ids is None else set(build_ids)
    for name, expected, actual in (('bead_closed', expected_tasks, value['bead_closed']), ('diff_nonempty', expected_builds, value['diff_nonempty'])):
        if set(actual) != expected:
            raise ContractError('task-key-coverage', f'{name} must have exactly the declared task keys')
    if main_branch is not None and value['main_branch'] != main_branch:
        raise ContractError('wrong-main-branch', f"close result names `{value['main_branch']}`, expected `{main_branch}`")
    if final and (not value.get('acceptance_commit')):
        raise ContractError('missing-acceptance-commit', 'final close requires acceptance_commit')
    if value['status'] == 'complete':
        if value['refused_rows']:
