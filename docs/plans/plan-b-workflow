            lock.close()

def refresh_state():
    with STATE_LOCK:
        lock = open(STATE_PATH + '.lock', 'a+')
        fcntl.flock(lock.fileno(), fcntl.LOCK_SH)
        try:
            try:
                with open(STATE_PATH) as handle:
                    disk = json.load(handle)
            except (OSError, ValueError):
                disk = {}
        finally:
            fcntl.flock(lock.fileno(), fcntl.LOCK_UN)
            lock.close()
        if isinstance(disk.get('decisions'), dict):
            STATE['decisions'].update(disk['decisions'])
        for key, value in (disk.get('coordinator') or {}).items():
            mine = STATE.setdefault('coordinator', {}).get(key)
            if key.endswith(':acknowledgement') and value and (not mine):
                STATE['coordinator'][key] = value
