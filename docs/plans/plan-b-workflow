    if decision == 'fix' and (not value['fix_tasks']):
        raise ContractError('decision-fix-without-tasks', 'decision `fix` requires non-empty fix_tasks')
    if decision != 'fix' and value['fix_tasks']:
        raise ContractError('decision-fix-tasks-mismatch', 'fix_tasks is allowed exactly when decision is `fix`')
    if decision == 'coordinate' and (not value['coordinator_tasks']):
        raise ContractError('decision-coordinate-without-tasks', 'decision `coordinate` requires coordinator_tasks')
    if decision == 'close' and value['coordinator_tasks']:
        raise ContractError('decision-coordinate-tasks-mismatch', 'coordinator_tasks requires decision `coordinate` or `fix`')
    disposition_ids = []
    disposition_by_id = {}
    for disposition in value['dispositions']:
        finding_id = disposition['id']
        _require_reference(finding_id, known_ids, 'disposition')
        if finding_id in disposition_by_id:
            raise ContractError('duplicate-disposition', f'finding id `{finding_id}` has more than one disposition')
        disposition_ids.append(finding_id)
        disposition_by_id[finding_id] = disposition
        finding = finding_by_id.get(finding_id) if finding_by_id is not None else None
        if finding is not None and disposition['severity'] != finding['severity']:
            raise ContractError('severity-mismatch', f'disposition severity disagrees with finding `{finding_id}`')
    if known_ids is not None:
        missing = known_ids - set(disposition_ids)
        if missing:
            raise ContractError('missing-disposition', f'finding(s) lack exactly one disposition: {sorted(missing)}')
    for task in value['fix_tasks']:
        for finding_id in task['fixes']:
            _require_reference(finding_id, known_ids, f"fix task `{task['id']}`")
    seen_residue = set()
    if severity_floor not in _SEVERITY_RANK:
        raise ContractError('unknown-severity', f'unknown severity floor `{severity_floor}`')
    for finding_id in value['accepted_residue']:
        _require_reference(finding_id, known_ids, 'accepted_residue')
        if finding_id in seen_residue:
            raise ContractError('duplicate-accepted-residue', f'finding `{finding_id}` appears twice in accepted_residue')
