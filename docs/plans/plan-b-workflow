def await_decision(item):
    task_id = item['id']
    while True:
        if ABORT_EVENT.is_set():
            raise SystemExit('item ' + task_id + ' was parked when the workflow paused; resume re-parks it')
        refresh_state()
        decision = STATE['decisions'].get(task_id)
        action = str(decision.get('action', '')).lower() if isinstance(decision, dict) else ''
        if action in ('continue', 'done', 'retry'):
            parked = STATE['parked'].get(task_id) or {}
            attempt = item_attempt_key(item)
            with STATE_LOCK:
                if action == 'continue':
                    approve_gate(task_id, parked.get('stage'), attempt)
                elif action == 'retry':
                    target = stage_key(item) if item.get('kind') == 'task' and item.get('stage') in ('execute', 'fix') else item_attempt_key(item)
                    reject_cached(target, str(decision.get('reason') or 'plan-unpark retry rejects cached result'))
                    STATE['attempts'][attempt] = int(STATE['attempts'].get(attempt, 0)) + 1
                    clear_approvals(task_id, attempt)
                    if item['stage'] in ('execute', 'fix'):
                        STATE['overrides'].pop(stage_key(item), None)
                    _invalidate_settled_closes(item.get('wave'))
                else:
                    STATE['forced_done'][task_id] = True
                    clear_approvals(task_id)
                STATE['parked'].pop(task_id, None)
                STATE['decisions'].pop(task_id, None)
                DECISION_TOMBSTONES.add(task_id)
                save_state()
            if action != 'done':
                task = item.get('task') or {}
                active_clock_resume(task_id, str(task.get('regime') or task.get('review_tier') or 'standard'))
            log('UNPARKED ' + task_id + ' with action ' + action)
            if action == 'retry':
                raise RetryStage()
            if action == 'done':
                raise FinishItem()
            return
        threading.Event().wait(park_poll_seconds())

