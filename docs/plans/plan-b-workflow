def _schema_errors(value, schema, path='value'):
    kind = schema.get('type')
    if kind == 'object':
        if not isinstance(value, dict):
            yield ('wrong-type', 'expected an object', path)
            return
        properties = schema.get('properties', {})
        for key in schema.get('required', []):
            if key not in value:
                yield ('missing-field', f'missing required field `{key}`', f'{path}.{key}')
        additional = schema.get('additionalProperties', True)
        if additional is False:
            for key in value:
                if key not in properties:
                    code = 'legacy-dry-key' if key == 'dry' and path == 'value' else 'unknown-field'
                    yield (code, f'unknown field `{key}`', f'{path}.{key}')
        for key, child in value.items():
            child_schema = properties.get(key)
            if child_schema is None:
                if isinstance(additional, dict):
                    child_schema = additional
                else:
                    continue
            yield from _schema_errors(child, child_schema, f'{path}.{key}')
        return
    if kind == 'array':
        if not isinstance(value, (list, tuple)):
            yield ('wrong-type', 'expected an array', path)
            return
        if schema is _ROW_ID_SCHEMA and len(value) != 4:
            yield ('bad-declared-row-id', 'declared row id must have exactly four fields', path)
            return
        minimum = schema.get('minItems')
        if minimum is not None and len(value) < minimum:
            yield ('too-few-items', f'expected at least {minimum} item(s)', path)
        item_schema = schema.get('items')
        if item_schema:
            for index, child in enumerate(value):
                yield from _schema_errors(child, item_schema, f'{path}[{index}]')
        return
    if kind == 'string':
        if not isinstance(value, str):
            yield ('wrong-type', 'expected a string', path)
        elif not value.strip():
            if path.endswith('.note'):
                return
            if path.endswith('.evidence'):
                code = 'empty-evidence'
            elif path.endswith('.reason'):
                code = 'empty-reason'
            elif path.endswith('.because'):
                code = 'empty-because'
            else:
                code = 'empty-value'
            yield (code, 'must not be empty', path)
        elif schema.get('enum') is not None and value not in schema['enum']:
            code = 'unknown-severity' if path.endswith('.severity') else 'invalid-value'
            yield (code, f"must be one of {schema['enum']!r}", path)
        return
    if kind == 'integer':
        if not isinstance(value, int) or isinstance(value, bool):
            yield ('wrong-type', 'expected an integer', path)
        return
    if kind == 'boolean':
        if not isinstance(value, bool):
            yield ('wrong-type', 'expected a boolean', path)
        return
    allowed = schema.get('enum')
    if allowed is not None and value not in allowed:
        code = 'unknown-severity' if path.endswith('.severity') else 'invalid-value'
        yield (code, f'must be one of {allowed!r}', path)

def _validate_transport(value, schema):
