        if severity is not None and _SEVERITY_RANK[severity] < _SEVERITY_RANK[severity_floor]:
            raise ContractError('residue-above-floor', f'accepted residue `{finding_id}` is above severity floor')
    for task in value['coordinator_tasks']:
        for finding_id in task['finding_ids']:
            _require_reference(finding_id, known_ids, f"coordinator task `{task['id']}`")
    return value

def validate_fix_verdict(value, findings=None, adopted=None, fix_finding_ids=None, *, adopted_findings=None, diff_finding_ids=None):
