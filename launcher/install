#!/bin/sh
# launcher/install — idempotent installer for the agent-session launcher.
#
#   launcher/install            install/refresh, print source+installed hashes
#   launcher/install --check    verify installed == source, exit 1 on drift
#   launcher/install --uninstall  remove the installed tree + vendor symlinks
#
# Installs COPIES (never symlinks into a mutable checkout) to:
#   ~/.local/libexec/post-launcher/agent-session
#   ~/.local/libexec/post-launcher/shims/{claude,codex,cursor,grok}
# and maintains vendor-named symlinks in ~/.local/agent-shims/ pointing at
# the INSTALLED shims. Profile seams (zshrc, codex-profile) should reference
# the installed helper path, so a branch switch or checkout move in the
# source repo can never change live launch behavior without a re-install.
set -u

SOURCE_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P)
PREFIX="${POST_LAUNCHER_PREFIX:-$HOME/.local/libexec/post-launcher}"
SHIM_LINK_DIR="${POST_AGENT_SHIM_DIR:-$HOME/.local/agent-shims}"
FILES="agent-session shims/claude shims/codex shims/cursor shims/grok"
# vendor-name:shim-name pairs for the PATH symlinks
LINKS="claude:claude codex:codex cursor-agent:cursor grok:grok"

fail() { printf 'install: %s\n' "$1" >&2; exit 1; }

hash_of() {
    digest=$(shasum -a 256 "$1" 2>/dev/null) || fail "cannot hash $1"
    printf '%s' "$digest" | cut -d' ' -f1
}

# Ownership receipt: written by install, required by uninstall. Binds the
# PHYSICAL prefix path and the exact sha256 of every installed file, so
# uninstall can prove it created what it is about to delete. No receipt, or
# a receipt bound to a different prefix, means no file deletion at all.
RECEIPT_NAME=.install-receipt

physical_path() {
    (cd "$1" 2>/dev/null && pwd -P)
}

write_receipt() {
    phys=$(physical_path "$PREFIX") || fail "cannot resolve physical prefix for receipt"
    {
        printf 'prefix %s\n' "$phys"
        for f in $FILES; do
            printf 'file %s %s\n' "$f" "$(hash_of "$PREFIX/$f")"
        done
    } > "$PREFIX/$RECEIPT_NAME" || fail "cannot write receipt"
}

# Look up $1 in the receipt's file entries; print the recorded hash.
receipt_hash_for() {
    awk -v name="$1" '$1 == "file" && $2 == name { print $3; exit }' \
        "$PREFIX/$RECEIPT_NAME" 2>/dev/null
}

mode=install
case "${1:-}" in
    '') ;;
    --check) mode=check ;;
    --uninstall) mode=uninstall ;;
    *) fail "unknown argument '$1' (usage: install [--check|--uninstall])" ;;
esac

if [ "$mode" = uninstall ]; then
    # Delete only what this installer owns: unlink a vendor symlink only when
    # its readlink target is our installed shim, remove only the exact managed
    # files, and rmdir directories only when empty. Never rm -rf a
    # caller-controlled prefix.
    for pair in $LINKS; do
        vendor=${pair%%:*}
        shim=${pair#*:}
        link="$SHIM_LINK_DIR/$vendor"
        [ -L "$link" ] || continue
        current=$(readlink "$link" 2>/dev/null || printf '')
        if [ "$current" = "$PREFIX/shims/$shim" ]; then
            rm "$link" && printf 'install: removed %s\n' "$link"
        else
            printf 'install: leaving %s (points to %s, not ours)\n' "$link" "$current"
        fi
    done
    if [ -f "$PREFIX/$RECEIPT_NAME" ]; then
        recorded_prefix=$(awk '$1 == "prefix" { $1=""; sub(/^ /,""); print; exit }' "$PREFIX/$RECEIPT_NAME")
        actual_prefix=$(physical_path "$PREFIX" || printf '')
        if [ "$recorded_prefix" = "$actual_prefix" ] && [ -n "$actual_prefix" ]; then
            for f in $FILES; do
                dst="$PREFIX/$f"
                [ -f "$dst" ] || continue
                owned=$(receipt_hash_for "$f")
                current=$(shasum -a 256 "$dst" 2>/dev/null | cut -d' ' -f1)
                if [ -n "$owned" ] && [ "$owned" = "$current" ]; then
                    rm "$dst" && printf 'install: removed %s\n' "$dst"
                else
                    printf 'install: leaving %s (modified since install; not ours to delete)\n' "$dst"
                fi
            done
            rm "$PREFIX/$RECEIPT_NAME"
        else
            printf 'install: receipt is bound to %s, not %s; leaving all files\n' \
                "${recorded_prefix:-<unreadable>}" "${actual_prefix:-<unresolvable>}"
        fi
    else
        printf 'install: no install receipt in %s; leaving all files (never installed here, or pre-receipt install — re-run install once to mint one)\n' "$PREFIX"
    fi
    rmdir "$PREFIX/shims" 2>/dev/null && printf 'install: removed %s\n' "$PREFIX/shims"
    rmdir "$PREFIX" 2>/dev/null && printf 'install: removed %s\n' "$PREFIX" \
        || { [ -d "$PREFIX" ] && printf 'install: leaving non-empty %s\n' "$PREFIX"; }
    printf 'install: profile seams in ~/.zshrc and codex-profile fail open when the helper is absent; remove their blocks at leisure\n'
    exit 0
fi

drift=0
for f in $FILES; do
    src="$SOURCE_DIR/$f"
    dst="$PREFIX/$f"
    [ -f "$src" ] || fail "source file missing: $src"
    src_hash=$(hash_of "$src")
    if [ -f "$dst" ]; then
        dst_hash=$(hash_of "$dst")
    else
        dst_hash=absent
    fi
    if [ "$mode" = check ]; then
        if [ "$src_hash" = "$dst_hash" ]; then
            printf 'check: %s OK %s\n' "$f" "$src_hash"
        else
            printf 'check: %s DRIFT source=%s installed=%s\n' "$f" "$src_hash" "$dst_hash"
            drift=1
        fi
        continue
    fi
    if [ "$src_hash" != "$dst_hash" ]; then
        mkdir -p "$(dirname "$dst")" || fail "cannot create $(dirname "$dst")"
        cp -f "$src" "$dst" || fail "cannot install $dst"
        chmod 0755 "$dst" || fail "cannot chmod $dst"
        printf 'install: %s -> %s\n' "$f" "$dst"
    fi
    printf 'hash: %s source=%s installed=%s\n' "$f" "$src_hash" "$(hash_of "$dst")"
done

if [ "$mode" = check ]; then
    for pair in $LINKS; do
        vendor=${pair%%:*}
        shim=${pair#*:}
        link="$SHIM_LINK_DIR/$vendor"
        target="$PREFIX/shims/$shim"
        current=$(readlink "$link" 2>/dev/null || printf 'absent')
        if [ "$current" = "$target" ]; then
            printf 'check: link %s OK -> %s\n' "$vendor" "$target"
        else
            printf 'check: link %s DRIFT expected=%s actual=%s\n' "$vendor" "$target" "$current"
            drift=1
        fi
    done
    exit "$drift"
fi

write_receipt

mkdir -p "$SHIM_LINK_DIR" || fail "cannot create $SHIM_LINK_DIR"
for pair in $LINKS; do
    vendor=${pair%%:*}
    shim=${pair#*:}
    target="$PREFIX/shims/$shim"
    link="$SHIM_LINK_DIR/$vendor"
    current=$(readlink "$link" 2>/dev/null || printf '')
    if [ "$current" != "$target" ]; then
        ln -sf "$target" "$link" || fail "cannot link $link"
        printf 'install: %s -> %s\n' "$link" "$target"
    fi
done
printf 'install: done (prefix %s)\n' "$PREFIX"
